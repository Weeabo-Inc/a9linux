	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x01>;
		interrupt-names = "phys", "virt";
		interrupts = <0x01 0x02 0x04 0x01 0x03 0x04>;
	};

	pmu {
		compatible = "apple,twister-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x4c 0x04 0x00 0x4f 0x04>;
		interrupt-affinity = <0x26 0x27>;
	};

	opp-table {
		compatible = "operating-points-v2";
		phandle = <0x02>;

		opp01 {
			opp-hz = <0x00 0x11e1a300>;
			opp-level = <0x01>;
			clock-latency-ns = <0x1f4>;
		};

		opp02 {
			opp-hz = <0x00 0x179a7b00>;
			opp-level = <0x02>;
			clock-latency-ns = <0xafc8>;
		};

		opp03 {
			opp-hz = <0x00 0x23c34600>;
			opp-level = <0x03>;
			clock-latency-ns = <0x55f0>;
		};

		opp04 {
			opp-hz = <0x00 0x365c0400>;
			opp-level = <0x04>;
			clock-latency-ns = <0x61a8>;
		};

		opp05 {
			opp-hz = <0x00 0x47868c00>;
			opp-level = <0x05>;
			clock-latency-ns = <0x6d60>;
		};

		opp06 {
			opp-hz = <0x00 0x5a1f4a00>;
			opp-level = <0x06>;
			clock-latency-ns = <0x88b8>;
		};

		opp07 {
			opp-hz = <0x00 0x6b49d200>;
			opp-level = <0x07>;
			clock-latency-ns = <0x9470>;
		};
	};

	aliases {
		ausbphy0 = "/soc/bus@20c000000/phy@20c000030";
		serial0 = "/soc/serial@20a0c0000";
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0";

		/*
		 * MEASURED as-built : this property does NOT exist. With CONFIG_CMDLINE=""
		 *   and no CONFIG_CMDLINE_EXTEND/FORCE, the kernel is handed an EMPTY
		 *   command line (drivers/of/fdt.c:1124-1145). No console at all.
		 *
		 * TARGET: the a9boot-supplied string below. Every token -- and the ORDER of the
		 *   two console= tokens -- is justified in LOADER-FILL.md sec 4. Two things here
		 *   are load-bearing and must not be "tidied up":
		 *
		 * (1) console=ttySAC0 comes FIRST, console=ttyGS0 LAST.
		 *     The LAST console= becomes /dev/console: __add_preferred_console() sets
		 *     preferred_console to the entry just added, and try_enable_preferred_console()
		 *     grants CON_CONSDEV to that index only (kernel/printk/printk.c). Putting the
		 *     USB gadget last is what makes it BOTH the interactive console AND the one
		 *     that keeps CON_PRINTBUFFER.
		 *
		 * (2) THERE IS NO earlycon TOKEN, AND THAT IS DELIBERATE -- do not add one until a
		 *     UART is physically attached and readable. earlycon registers a CON_BOOT
		 *     console (drivers/tty/serial/earlycon.c:31), and register_console() then runs:
		 *         if (bootcon_registered &&
		 *             ((newcon->flags & (CON_CONSDEV | CON_BOOT)) == CON_CONSDEV))
		 *                 newcon->flags &= ~CON_PRINTBUFFER;
		 *     ttyGS0 IS the CON_CONSDEV console, so adding earlycon silently CLEARS its
		 *     CON_PRINTBUFFER -- and with that flag cleared its init_seq becomes
		 *     prb_next_seq(prb), i.e. it replays NOTHING and shows only messages logged
		 *     after it registers (printk.c: get_init_console_seq). The UART is almost
		 *     certainly unreachable (CONSOLE-SIGNALS.md Q1), so earlycon would buy
		 *     invisible output and cost us the entire boot log.
		 *
		 * Also absent on purpose: keep_bootcon (meaningless with no boot console),
		 * ignore_loglevel and initcall_debug (LOADER-FILL.md sec 4.4 -- the gadget carries
		 * only ~8 KiB of backlog, so log volume is a real cost on the first boot).
		 *
		 * The UART tokens, if a UART is ever attached, are in LOADER-FILL.md sec 4.5.
		 */
		bootargs = "console=ttySAC0 console=ttyGS0 nokaslr clk_ignore_unused pd_ignore_unused panic=20";

		/*
		 * TARGET (EXAMPLE / INFERRED addresses, MEASURED sizes):
		 *   initramfs placed at 0x8_1000_0000 in the worked example layout
		 *   (LOADER-FILL.md sec 3). Size below is the real size of the built artefact
		 *   a9linux/artefacts/initramfs.gz (2,669,875 B, page-aligned up to 0x28C000).
		 *
		 * a9boot MUST compute these two from where it actually put the initramfs and
		 * MUST NOT copy these constants. The kernel reserves exactly
		 * [linux,initrd-start, linux,initrd-end) itself -- arch/arm64/mm/init.c:278-288 --
		 * so these two properties are load-bearing: a wrong value either loses the
		 * rootfs or reserves the wrong RAM.
		 * Both properties are ABSENT as-built (MEASURED).
		 * Each is a single u64 in TWO big-endian cells (drivers/of/fdt.c:817-825 reads
		 * len/4 cells), NOT four. Getting the cell count wrong here silently truncates
		 * the address -- which is why a9boot must compute, not copy, these.
		 */
		linux,initrd-start = <0x08 0x10000000>;
		linux,initrd-end = <0x08 0x1028c000>;

		/* keep the loader's framebuffer alive across simpledrm probe */
		framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			/*
			 * MEASURED as-built : reg = <0 0 0 0> and status = "disabled".
			 * TARGET for rung 1 (serial console only): LEAVE BOTH AS THEY ARE.
			 *   of_platform.c:161 refuses to create a platform device for a node
			 *   whose status is not "okay", so "disabled" is a safe no-op.
			 * TARGET for rung 2 (console on the panel) -- all five of these become
			 *   mandatory, because simpledrm_probe() fails outright without them
			 *   (simpledrm.c:674-686, drm_sysfb.c:23-31 rejects width/height 0):
			 *
			 *     reg    = <0x08 0x40000000 0x00 0x400000>;  base 0x8_40000000, size 4 MiB
			 *                                                  (4 cells: 2 addr + 2 size)
			 *     status = "okay";
			 *     width  = <0x280>;   640   INSPECTED (iPhone SE panel)
			 *     height = <0x470>;   1136  INSPECTED (iPhone SE panel)
			 *     stride = <0xa00>;   2560  = 640 * 4  INFERRED (assumes 32 bpp)
			 *     format = "a8b8g8r8";        INFERRED -- see LOADER-FILL.md sec 5
			 *
			 *   and an /reserved-memory child must cover the same range, or the
			 *   allocator will hand the scanout buffer out to someone else.
			 */
			reg = <0x00 0x00 0x00 0x00>;
			status = "disabled";
			power-domains = <0x19 0x28>;
		};
	};

	memory@800000000 {
		device_type = "memory";
		/*
		 * MEASURED as-built : <0x08 0x00 0x00 0x00>
		 *   -> base 0x8_0000_0000, size 0. Zero usable RAM.
		 * TARGET            : <0x08 0x00 0x00 0x80000000>
		 *   -> base 0x8_0000_0000, size 0x8000_0000 = 2 GiB.
		 * 4 cells = 2 addr + 2 size, per the root node's #address-cells/#size-cells.
		 *
		 * The BASE is INSPECTED -- it is the unit-address of this node in the upstream
		 * dtsi (arch/arm64/boot/dts/apple/s800-0-3-common.dtsi:33). The SIZE 2 GiB is
		 * INSPECTED from the iPhone SE product specification, not measured on this
		 * device; the top of usable DRAM is where a bootloader-reserved carve-out would
		 * live. A loader that leaves this at size 0 hands the kernel no RAM at all and
		 * the kernel panics before it can print anything.
		 * See LOADER-FILL.md sec 2 for how to settle the exact usable extent.
		 */
		reg = <0x08 0x00 0x00 0x80000000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		/*
		 * MEASURED as-built : this node is EMPTY -- no children at all.
		 *
		 * For the rung-1 target that is CORRECT and needs no change, because the kernel
		 * already reserves the three things that would otherwise be clobbered:
		 *   - the kernel image itself : arch/arm64/mm/init.c:293
		 *   - the initrd               : arch/arm64/mm/init.c:278-288 (from
		 *                                /chosen/linux,initrd-start/end)
		 *   - this DTB blob            : arch/arm64/kernel/setup.c:177
		 *
		 * The loader MUST add a child here in exactly two cases:
		 *   1. it hands over a FRAMEBUFFER -- simpledrm does NOT reserve it
		 *      (simpledrm.c:787 request_mem_region() fails on System RAM by design and
		 *      falls back to using the raw resource), so nothing stops the allocator
		 *      handing the scanout buffer to someone else. Use a plain child (NOT
		 *      no-map) covering the same range as framebuffer0's reg.
		 *   2. it parks SECONDARY CPUs for spin-table -- the arm64 boot protocol requires
		 *      the release location to sit in a reserved region:
		 *      Documentation/arch/arm64/booting.rst:589-601. Those secondaries keep
		 *      executing for the whole life of the kernel, so their memory must survive.
		 *
		 * Do NOT add a child for a9boot's own code unless something in it must still be
		 * running after the jump -- and never one that overlaps the kernel Image, this
		 * DTB, or the initrd. no-map removes the range from the linear map entirely.
		 */
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-home {
			label = "Home Button";
			gpios = <0x1f 0x60 0x01>;
			linux,code = <0xac>;
			wakeup-source;
		};

		button-power {
			label = "Power Button";
			gpios = <0x1f 0x61 0x01>;
			linux,code = <0x74>;
			wakeup-source;
		};

		button-voldown {
			label = "Volume Down";
			gpios = <0x1f 0x43 0x01>;
			linux,code = <0x72>;
		};

		button-volup {
			label = "Volume Up";
			gpios = <0x1f 0x42 0x01>;
			linux,code = <0x73>;
		};

		switch-mute {
			label = "Mute Switch";
			gpios = <0x1f 0x95 0x01>;
			linux,code = <0x71>;
		};
	};
};
