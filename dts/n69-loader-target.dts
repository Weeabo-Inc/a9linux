			};

			power-controller@80138 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80138 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
