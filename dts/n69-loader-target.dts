/*
 * n69ap LOADER-TARGET device tree -- iPhone SE 1st gen (Apple A9 s8003, board n69/n69ap)
 *
 * WHAT THIS IS
 *   The shape of the DTB that a9boot must hand to Linux at kernel entry (x0 = physical
 *   address of this blob). It is the tree's built s8003-n69.dtb with the loader-owned
 *   properties filled in using the EXAMPLE values from LOADER-FILL.md.
 *   Use it as (a) a diff target for a9boot's DTB patcher and (b) a test vector.
 *   Do NOT treat it as a flashable image: every value marked INFERRED must be replaced
 *   at runtime by a9boot with a measured one.
 *
 * PROVENANCE
 *   Source    : dtc -I dtb -O dts  arch/arm64/boot/dts/apple/s8003-n69.dtb
 *               kernel tree /build/linux-a9 (Linux 7.3.0-rc1)
 *   Parent    : s8003-n69.dtb sha256
 *               cbb79a148fec1377b7187a4c9514a968e519f3c2ee796818d41f08fde1dc1dfc  (22,880 B)
 *   Rebuild   : a9linux/dts/build/build-dtb.sh
 *
 * LABELS (HANDOFF sec 9.5): MEASURED = read from bytes on disk; INSPECTED = read from a
 *   cited source; INFERRED = reasoned but unconfirmed.
 *
 * This file is a dtc round-trip: no #include lines, phandles are plain numbers. That is
 * deliberate -- round-tripping needs neither cpp nor the kernel tree, which is exactly
 * what a9boot's host-side tooling has. See LOADER-FILL.md sec 7.
 */

/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	chassis-type = "handset";
	compatible = "apple,n69", "apple,s8003", "apple,arm-platform";
	model = "Apple iPhone SE (TSMC)";

	clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "clkref";
		phandle = <0x05>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "apple,twister";
			reg = <0x00 0x00>;
			cpu-release-addr = <0x00 0x00>;
			operating-points-v2 = <0x02>;
			performance-domains = <0x03>;
			enable-method = "spin-table";
			device_type = "cpu";
			next-level-cache = <0x04>;
			i-cache-size = <0x10000>;
			d-cache-size = <0x10000>;
			phandle = <0x26>;
		};

		cpu@1 {
			compatible = "apple,twister";
			reg = <0x00 0x01>;
			cpu-release-addr = <0x00 0x00>;
			operating-points-v2 = <0x02>;
			performance-domains = <0x03>;
			enable-method = "spin-table";
			device_type = "cpu";
			next-level-cache = <0x04>;
			i-cache-size = <0x10000>;
			d-cache-size = <0x10000>;
			phandle = <0x27>;
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x300000>;
			phandle = <0x04>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		nonposted-mmio;
		ranges;

		performance-controller@202220000 {
			compatible = "apple,s8000-cluster-cpufreq", "apple,t8103-cluster-cpufreq", "apple,cluster-cpufreq";
			reg = <0x02 0x2220000 0x00 0x1000>;
			#performance-domain-cells = <0x00>;
			phandle = <0x03>;
		};

		serial@20a0c0000 {
			compatible = "apple,s5l-uart";
			reg = <0x02 0xa0c0000 0x00 0x4000>;
			reg-io-width = <0x04>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xc0 0x04>;
			clocks = <0x05 0x05>;
			clock-names = "uart", "clk_uart_baud0";
			power-domains = <0x06>;
			status = "okay";
		};

		i2c@20a110000 {
			compatible = "apple,s8000-i2c", "apple,i2c";
			reg = <0x02 0xa110000 0x00 0x1000>;
			clocks = <0x05>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xce 0x04>;
			pinctrl-0 = <0x07>;
			pinctrl-names = "default";
			power-domains = <0x08>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			pmic@74 {
				compatible = "apple,antigua-pmic", "apple,i2c-pmic";
				reg = <0x74>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;

				rtc@500 {
					compatible = "apple,antigua-pmic-rtc";
					reg = <0x500 0x10>;
					nvmem-cells = <0x09>;
					nvmem-cell-names = "rtc_offset";
				};

				nvmem@5000 {
					compatible = "apple,pmic-nvmem";
					reg = <0x5000 0x28>;

					nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <0x01>;
						#size-cells = <0x01>;

						rtc-offset@4 {
							reg = <0x04 0x04>;
							phandle = <0x09>;
						};
					};
				};
			};
		};

		i2c@20a111000 {
			compatible = "apple,s8000-i2c", "apple,i2c";
			reg = <0x02 0xa111000 0x00 0x1000>;
			clocks = <0x05>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xcf 0x04>;
			pinctrl-0 = <0x0a>;
			pinctrl-names = "default";
			power-domains = <0x0b>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
		};

		i2c@20a112000 {
			compatible = "apple,s8000-i2c", "apple,i2c";
			reg = <0x02 0xa112000 0x00 0x1000>;
			clocks = <0x05>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xd0 0x04>;
			pinctrl-0 = <0x0c>;
			pinctrl-names = "default";
			power-domains = <0x0d>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
		};

		bus@20c000000 {
			compatible = "apple,s8000-usb-complex", "apple,s5l8960x-usb-complex", "simple-pm-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			dma-ranges = <0x00 0x00 0x08 0x00 0x01 0x00>;
			nonposted-mmio;
			ranges;
			reg = <0x02 0xc900000 0x00 0x100>;
			power-domains = <0x0e>;

			phy@20c000030 {
				compatible = "apple,s8000-ausb-phy", "apple,ausb-phy";
				reg = <0x02 0xc000030 0x00 0x20>;
				power-domains = <0x0f>;
				#phy-cells = <0x01>;
				/*
				 * AUSB PHY tunables -- MEASURED on n69ap hardware, 2026-10-03.
				 *
				 * Evidence: RUNG2-EVIDENCE.md sec 2 and a9pwn-traces/linux/
				 * rung2-fresh-1.json + rung2-fresh-2.json. Read as little-endian u32
				 * through the pwned payload's MEMC read; cfg0/cfg1 came back in two
				 * separate runs (started 13:29:19Z and 13:29:35Z, same DFU session) and
				 * were byte-identical both times (f3 23 37 37 04 0e 02 00). Non-zero AND
				 * stable is LOADER-FILL.md sec 12 step 2's pass condition, and it is
				 * satisfied. AUSB_CTL/AUSB_SIG below were each read ONCE. No value below
				 * was adjusted, rounded, or taken from another SoC's device tree.
				 *
				 *   apple,cfg0-device <- 0x373723F3   AUSB_CFG0 @ 0x20C000038  MEASURED
				 *   apple,cfg1-device <- 0x00020E04   AUSB_CFG1 @ 0x20C00003C  MEASURED
				 *
				 * MEASURED is the register *contents*. INSPECTED is that those contents
				 * are the device-role tunables: ausb.c:31-32 places AUSB_CFG0/CFG1 at
				 * 0x08/0x0c from this node's base 0x2_0C000030, and ausb.c:102-103 writes
				 * cfg{0,1}_device into exactly those two registers in power_on().
				 * INFERRED: the ROM left this PHY in the device role, because DFU is
				 * enumerated as a USB device in the very session that produced the read.
				 *
				 * AUSB_CTL and AUSB_SIG are context, MEASURED, and deliberately NOT
				 * properties: the driver reads no DT property for either and writes both
				 * itself in ausb_phy_usb2_power_on() (ausb.c:105-111), so a property here
				 * would be invented ABI with no consumer.
				 *   AUSB_CTL @ 0x20C000030 = 0x00000010
				 *     RESET(bit0)=0, PWRDOWN(bit2)=0, SIDDQ(bit3)=0 (ausb.c:20-23), so
				 *     LOADER-FILL.md sec 12 step 2's stated precondition for treating the
				 *     CFG reads as meaningful does hold. bit4 is SET and the driver names
				 *     no bit4; the capture's own note reads that set bit as "the PHY is
				 *     not in the DFU-idle state and this read is context, not a tunable".
				 *     So: precondition met, but "the PHY is up" is NOT claimed here --
				 *     recorded raw, unnamed bit and all.
				 *   AUSB_SIG @ 0x20C000034 = 0x0001C103
				 *     VBUSDET_FORCE_EN(bit1)=1 and CABLE_CONNECTED(bit8)=1 (ausb.c:25-28);
				 *     bits 14, 15 and 16 also read 1. bit14 lies inside the AUSB_SIG_HOST
				 *     field (7<<12, ausb.c:28); as a 3-bit field that reads 4, not 7.
				 *     Recorded raw rather than decoded further: this is context, not a
				 *     tunable, and nothing here is written back.
				 *
				 * apple,cfg0-host / apple,cfg1-host -- DECISION: ZERO, explicitly.
				 *   ausb.c:153-156 requires both PRESENT, but nothing in this kernel
				 *   consumes them: their only reader, ausb_phy_usb2_set_mode(), is inside
				 *   `#if 0` (ausb.c:63-95). So any u32 satisfies the probe. They are 0
				 *   because host-mode tunables were NOT measured -- the PHY is in device
				 *   role in DFU, and RUNG2-EVIDENCE.md sec 2 leaves this pair open.
				 *   Copying the measured device words into -host would present an
				 *   unmeasured guess in exactly the syntax of measured data. Zero is
				 *   recognisably "unset": if a future kernel re-enables set_mode(), host
				 *   mode fails visibly and must be re-measured, rather than silently
				 *   programming device tunables into the host role. Settling it needs a
				 *   host-mode session that reads AUSB_CFG0/CFG1 with the PHY in host role
				 *   -- tracked in PLACEHOLDER-INVENTORY.md sec 2.7.
				 */
				apple,cfg0-device = <0x373723f3>;
				apple,cfg1-device = <0x00020e04>;
				apple,cfg0-host = <0x00000000>;
				apple,cfg1-host = <0x00000000>;
				phandle = <0x10>;
			};

			usbdev@20c100000 {
				compatible = "apple,s8000-dwc2", "apple,dwc2";
				reg = <0x02 0xc100000 0x00 0x10000>;
				interrupts = <0x00 0xd6 0x04>;
				clocks = <0x05>;
				clock-names = "otg";
				phys = <0x10 0x03>;
				phy-names = "usb2-phy";
				power-domains = <0x11>;
				resets = <0x11>;
				dr_mode = "peripheral";
			};
		};

		power-management@20e000000 {
			compatible = "apple,s8000-pmgr", "apple,pmgr", "syscon", "simple-mfd";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x02 0xe000000 0x00 0x8c000>;

			power-controller@80000 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80000 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpu0";
				apple,always-on;
			};

			power-controller@80008 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80008 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpu1";
				apple,always-on;
			};

			power-controller@80040 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80040 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpm";
				apple,always-on;
			};

			power-controller@80150 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80150 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "sio_busif";
				phandle = <0x12>;
			};

			power-controller@80158 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80158 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "sio_p";
				power-domains = <0x12>;
				phandle = <0x13>;
			};

			power-controller@80100 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80100 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "sbr";
				apple,always-on;
			};

			power-controller@80108 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80108 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "aic";
				apple,always-on;
				phandle = <0x1c>;
			};

			power-controller@80110 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80110 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "dwi";
				phandle = <0x1d>;
			};

			power-controller@80118 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80118 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "gpio";
				phandle = <0x1e>;
			};

			power-controller@80120 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80120 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "pms";
				apple,always-on;
			};

			power-controller@80148 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80148 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "pcie_ref";
			};

			power-controller@80168 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80168 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "mca0";
				power-domains = <0x13>;
			};

			power-controller@80170 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80170 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "mca1";
				power-domains = <0x13>;
			};

			power-controller@80178 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80178 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "mca2";
				power-domains = <0x13>;
			};

			power-controller@80180 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80180 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "mca3";
				power-domains = <0x13>;
			};

			power-controller@80188 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80188 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "mca4";
				power-domains = <0x13>;
			};

			power-controller@80190 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80190 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "pwm0";
				power-domains = <0x13>;
			};

			power-controller@80198 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x80198 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "i2c0";
				power-domains = <0x13>;
				phandle = <0x08>;
			};

			power-controller@801a0 {
				compatible = "apple,s8000-pmgr-pwrstate", "apple,pmgr-pwrstate";
				reg = <0x801a0 0x04>;
				#power-domain-cells = <0x00>;
