/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	chassis-type = "handset";
	compatible = "apple,n69\0apple,s8003\0apple,arm-platform";
	model = "Apple iPhone SE (TSMC)";

	clock-ref {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "clkref";
		phandle = <0x05>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "apple,twister";
			reg = <0x00 0x00>;
			cpu-release-addr = <0x00 0x00>;
			operating-points-v2 = <0x02>;
			performance-domains = <0x03>;
			enable-method = "spin-table";
			device_type = "cpu";
			next-level-cache = <0x04>;
			i-cache-size = <0x10000>;
			d-cache-size = <0x10000>;
			phandle = <0x26>;
		};

		cpu@1 {
			compatible = "apple,twister";
			reg = <0x00 0x01>;
			cpu-release-addr = <0x00 0x00>;
			operating-points-v2 = <0x02>;
			performance-domains = <0x03>;
			enable-method = "spin-table";
			device_type = "cpu";
			next-level-cache = <0x04>;
			i-cache-size = <0x10000>;
			d-cache-size = <0x10000>;
			phandle = <0x27>;
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			cache-unified;
			cache-size = <0x300000>;
			phandle = <0x04>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		nonposted-mmio;
		ranges;

		performance-controller@202220000 {
			compatible = "apple,s8000-cluster-cpufreq\0apple,t8103-cluster-cpufreq\0apple,cluster-cpufreq";
			reg = <0x02 0x2220000 0x00 0x1000>;
			#performance-domain-cells = <0x00>;
			phandle = <0x03>;
		};

		serial@20a0c0000 {
			compatible = "apple,s5l-uart";
			reg = <0x02 0xa0c0000 0x00 0x4000>;
			reg-io-width = <0x04>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xc0 0x04>;
			clocks = <0x05 0x05>;
			clock-names = "uart\0clk_uart_baud0";
			power-domains = <0x06>;
			status = "okay";
		};

		i2c@20a110000 {
			compatible = "apple,s8000-i2c\0apple,i2c";
			reg = <0x02 0xa110000 0x00 0x1000>;
			clocks = <0x05>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xce 0x04>;
			pinctrl-0 = <0x07>;
			pinctrl-names = "default";
			power-domains = <0x08>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			pmic@74 {
				compatible = "apple,antigua-pmic\0apple,i2c-pmic";
				reg = <0x74>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;

				rtc@500 {
					compatible = "apple,antigua-pmic-rtc";
					reg = <0x500 0x10>;
					nvmem-cells = <0x09>;
					nvmem-cell-names = "rtc_offset";
				};

				nvmem@5000 {
					compatible = "apple,pmic-nvmem";
					reg = <0x5000 0x28>;

					nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <0x01>;
						#size-cells = <0x01>;

						rtc-offset@4 {
							reg = <0x04 0x04>;
							phandle = <0x09>;
						};
					};
				};
			};
		};

		i2c@20a111000 {
			compatible = "apple,s8000-i2c\0apple,i2c";
			reg = <0x02 0xa111000 0x00 0x1000>;
			clocks = <0x05>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xcf 0x04>;
			pinctrl-0 = <0x0a>;
			pinctrl-names = "default";
			power-domains = <0x0b>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
		};

		i2c@20a112000 {
			compatible = "apple,s8000-i2c\0apple,i2c";
			reg = <0x02 0xa112000 0x00 0x1000>;
			clocks = <0x05>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0xd0 0x04>;
			pinctrl-0 = <0x0c>;
			pinctrl-names = "default";
			power-domains = <0x0d>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
		};

		bus@20c000000 {
			compatible = "apple,s8000-usb-complex\0apple,s5l8960x-usb-complex\0simple-pm-bus";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			dma-ranges = <0x00 0x00 0x08 0x00 0x01 0x00>;
			nonposted-mmio;
			ranges;
			reg = <0x02 0xc900000 0x00 0x100>;
			power-domains = <0x0e>;

			phy@20c000030 {
				compatible = "apple,s8000-ausb-phy\0apple,ausb-phy";
				reg = <0x02 0xc000030 0x00 0x20>;
				power-domains = <0x0f>;
				#phy-cells = <0x01>;
				phandle = <0x10>;
			};

			usbdev@20c100000 {
				compatible = "apple,s8000-dwc2\0apple,dwc2";
				reg = <0x02 0xc100000 0x00 0x10000>;
				interrupts = <0x00 0xd6 0x04>;
				clocks = <0x05>;
				clock-names = "otg";
				phys = <0x10 0x03>;
				phy-names = "usb2-phy";
				power-domains = <0x11>;
				resets = <0x11>;
				dr_mode = "peripheral";
			};
		};

		power-management@20e000000 {
			compatible = "apple,s8000-pmgr\0apple,pmgr\0syscon\0simple-mfd";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x02 0xe000000 0x00 0x8c000>;

			power-controller@80000 {
				compatible = "apple,s8000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x80000 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpu0";
				apple,always-on;
			};

			power-controller@80008 {
				compatible = "apple,s8000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x80008 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpu1";
				apple,always-on;
			};

			power-controller@80040 {
				compatible = "apple,s8000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x80040 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "cpm";
				apple,always-on;
			};

			power-controller@80150 {
				compatible = "apple,s8000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x80150 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "sio_busif";
				phandle = <0x12>;
			};

			power-controller@80158 {
				compatible = "apple,s8000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x80158 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "sio_p";
				power-domains = <0x12>;
				phandle = <0x13>;
			};

			power-controller@80100 {
				compatible = "apple,s8000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x80100 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "sbr";
				apple,always-on;
			};

			power-controller@80108 {
				compatible = "apple,s8000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x80108 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "aic";
				apple,always-on;
				phandle = <0x1c>;
			};

			power-controller@80110 {
				compatible = "apple,s8000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x80110 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
