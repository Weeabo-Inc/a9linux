		interrupt-controller@20e100000 {
			compatible = "apple,s8000-aic\0apple,aic";
			reg = <0x02 0xe100000 0x00 0x100000>;
			#interrupt-cells = <0x03>;
			interrupt-controller;
			power-domains = <0x1c>;
			phandle = <0x01>;
		};

		backlight@20e200080 {
			compatible = "apple,s8000-dwi-bl\0apple,dwi-bl";
			reg = <0x02 0xe200080 0x00 0x08>;
			power-domains = <0x1d>;
			status = "okay";
		};

		pinctrl@20f100000 {
			compatible = "apple,s8000-pinctrl\0apple,pinctrl";
			reg = <0x02 0xf100000 0x00 0x100000>;
			power-domains = <0x1e>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x1f 0x00 0x00 0xd0>;
			apple,npins = <0xd0>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x2a 0x04 0x00 0x2b 0x04 0x00 0x2c 0x04 0x00 0x2d 0x04 0x00 0x2e 0x04 0x00 0x2f 0x04 0x00 0x30 0x04>;
			phandle = <0x1f>;

			i2c0-pins {
				pinmux = <0x1002e 0x1002d>;
				phandle = <0x07>;
			};

			i2c1-pins {
				pinmux = <0x10073 0x10072>;
				phandle = <0x0a>;
			};

			i2c2-pins {
				pinmux = <0x10017 0x10016>;
				phandle = <0x0c>;
			};
		};

		pinctrl@2100f0000 {
			compatible = "apple,s8000-pinctrl\0apple,pinctrl";
			reg = <0x02 0x100f0000 0x00 0x100000>;
			power-domains = <0x20>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x21 0x00 0x00 0x2a>;
			apple,npins = <0x2a>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x71 0x04 0x00 0x72 0x04 0x00 0x73 0x04 0x00 0x74 0x04 0x00 0x75 0x04 0x00 0x76 0x04 0x00 0x77 0x04>;
			phandle = <0x21>;
		};

		power-management@210200000 {
			compatible = "apple,s8000-pmgr\0apple,pmgr\0syscon\0simple-mfd";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			reg = <0x02 0x10200000 0x00 0x84000>;

			power-controller@80000 {
				compatible = "apple,s8000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x80000 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "aop";
				power-domains = <0x22 0x23 0x24>;
				apple,always-on;
				phandle = <0x25>;
			};

			power-controller@80008 {
				compatible = "apple,s8000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x80008 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "debug";
			};

			power-controller@80010 {
				compatible = "apple,s8000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x80010 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "aop_gpio";
				power-domains = <0x25>;
				phandle = <0x20>;
			};

			power-controller@80040 {
				compatible = "apple,s8000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x80040 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "aop_cpu";
				phandle = <0x23>;
			};

			power-controller@80048 {
				compatible = "apple,s8000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x80048 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "aop_filter";
				phandle = <0x24>;
			};

			power-controller@80050 {
				compatible = "apple,s8000-pmgr-pwrstate\0apple,pmgr-pwrstate";
				reg = <0x80050 0x04>;
				#power-domain-cells = <0x00>;
				#reset-cells = <0x00>;
				label = "aop_busif";
				phandle = <0x22>;
			};
		};

		watchdog@2102b0000 {
			compatible = "apple,s8000-wdt\0apple,wdt";
			reg = <0x02 0x102b0000 0x00 0x4000>;
			clocks = <0x05>;
			interrupt-parent = <0x01>;
			interrupts = <0x00 0x04 0x04>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <0x01>;
		interrupt-names = "phys\0virt";
		interrupts = <0x01 0x02 0x04 0x01 0x03 0x04>;
	};

	pmu {
		compatible = "apple,twister-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x00 0x4c 0x04 0x00 0x4f 0x04>;
		interrupt-affinity = <0x26 0x27>;
	};

	opp-table {
		compatible = "operating-points-v2";
		phandle = <0x02>;

		opp01 {
			opp-hz = <0x00 0x11e1a300>;
			opp-level = <0x01>;
			clock-latency-ns = <0x1f4>;
		};

		opp02 {
			opp-hz = <0x00 0x179a7b00>;
			opp-level = <0x02>;
			clock-latency-ns = <0xafc8>;
		};

		opp03 {
			opp-hz = <0x00 0x23c34600>;
			opp-level = <0x03>;
			clock-latency-ns = <0x55f0>;
		};

		opp04 {
			opp-hz = <0x00 0x365c0400>;
			opp-level = <0x04>;
			clock-latency-ns = <0x61a8>;
		};

		opp05 {
			opp-hz = <0x00 0x47868c00>;
			opp-level = <0x05>;
			clock-latency-ns = <0x6d60>;
		};

		opp06 {
			opp-hz = <0x00 0x5a1f4a00>;
			opp-level = <0x06>;
			clock-latency-ns = <0x88b8>;
		};

		opp07 {
			opp-hz = <0x00 0x6b49d200>;
			opp-level = <0x07>;
			clock-latency-ns = <0x9470>;
		};
	};

	aliases {
		ausbphy0 = "/soc/bus@20c000000/phy@20c000030";
		serial0 = "/soc/serial@20a0c0000";
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0";

		framebuffer@0 {
			compatible = "apple,simple-framebuffer\0simple-framebuffer";
			reg = <0x00 0x00 0x00 0x00>;
			status = "disabled";
			power-domains = <0x19 0x28>;
		};
	};

	memory@800000000 {
		device_type = "memory";
		reg = <0x08 0x00 0x00 0x00>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-home {
			label = "Home Button";
			gpios = <0x1f 0x60 0x01>;
			linux,code = <0xac>;
			wakeup-source;
		};

		button-power {
			label = "Power Button";
			gpios = <0x1f 0x61 0x01>;
			linux,code = <0x74>;
			wakeup-source;
		};

		button-voldown {
			label = "Volume Down";
			gpios = <0x1f 0x43 0x01>;
			linux,code = <0x72>;
		};

		button-volup {
			label = "Volume Up";
			gpios = <0x1f 0x42 0x01>;
			linux,code = <0x73>;
		};

		switch-mute {
			label = "Mute Switch";
			gpios = <0x1f 0x95 0x01>;
			linux,code = <0x71>;
		};
	};
};
